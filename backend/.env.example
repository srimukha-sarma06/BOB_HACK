# Optional: Richer architecture summaries (recommended for better insights)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional: OpenAI alternative (if you prefer OpenAI over Groq)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: Private GitHub repo access (only needed for private repositories)
# GITHUB_TOKEN=your_github_pat_here

# Note: The app works without any API keys!
# - Repo scanning, scoring, and vector search work offline
# - Bob prompts are generated without LLM calls
# - Only the architecture summary uses LLM (falls back to static summary if no key)
